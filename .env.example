# URL pooled (hostname con -pooler): usada por Next.js en tiempo de ejecución.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# URL directa (hostname sin -pooler): usada por Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Gmail SMTP. Usá una contraseña de aplicación, no la contraseña normal de Gmail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASSWORD="tu-contraseña-de-aplicación"
EMAIL_FROM="SIGESMED <tu-cuenta@gmail.com>"
